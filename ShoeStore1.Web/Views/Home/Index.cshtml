@model HomeViewModel

@{
    ViewData["Title"] = "Ana Sayfa";
}

<!-- 1. BÖLÜM: ÖNE ÇIKANLAR (FEATURED) -->
<section class="mb-5 mt-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">🌟 Öne Çıkanlar</h2>
    </div>

    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var item in Model.FeatureProducts)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 bg-dark text-white rounded-4 overflow-hidden">
                    <img src="@item.ImageUrl" class="card-img opacity-75" alt="@item.Name" style="height: 250px; object-fit: cover;">
                    <div class="card-img-overlay d-flex flex-column justify-content-end">
                        <h5 class="card-title fw-bold mb-0">@item.Name</h5>
                        <p class="card-text text-warning fw-bold fs-5">@item.Price ₺</p>
                        <a href="/Product/Detail/@item.Id" class="btn btn-light btn-sm w-50 mt-2 rounded-pill fw-bold">İncele</a>
                    </div>
                </div>
            </div>
        }
    </div>
</section>


<hr class="mb-5 text-muted" />

<!-- 2. BÖLÜM: FİLTRE VE LİSTE ALANI -->
<div class="row">

    <!-- SOL TARAF: FİLTRE MENÜSÜ -->
    <aside class="col-lg-3 mb-4">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                <h5 class="fw-bold">Filtreler</h5>
            </div>
            <div class="card-body">

                <form id="filterForm">
                    <!-- Kategori Filtresi -->
                    <div class="mb-4">
                        <label class="form-label fw-bold small text-muted">KATEGORİLER</label>
                        @foreach (var item in Model.Categories)
                        {
                            <div class="form-check">
                                <!-- value değerlerini ekledik ve 'filter-category' sınıfını verdik -->
                                <input class="form-check-input filter-category" type="checkbox" value="@item.Id" id="@item.Id">
                                <label class="form-check-label" for="@item.Id">@item.Name</label>
                            </div>
                        }
                    </div>

                    <!-- Fiyat Filtresi -->
                    <div class="mb-4">
                        <label class="form-label fw-bold small text-muted">FİYAT ARALIĞI</label>
                        <div class="row g-2">
                            <div class="col-6">
                                <!-- id="minPrice" eklendi -->
                                <input type="number" id="minPrice" class="form-control form-control-sm" placeholder="En Az">
                            </div>
                            <div class="col-6">
                                <!-- id="maxPrice" eklendi -->
                                <input type="number" id="maxPrice" class="form-control form-control-sm" placeholder="En Çok">
                            </div>
                        </div>
                    </div>

                    <!-- id="btnFilter" eklendi -->
                    <button type="button" id="btnFilter" class="btn btn-primary w-100 fw-bold">Filtrele</button>
                </form>

            </div>
        </div>
    </aside>

    <!-- SAĞ TARAF: ÜRÜN LİSTESİ (Varsayılan: Son Eklenenler) -->
    <main class="col-lg-9">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="fw-bold m-0" id="listTitle">Son Eklenenler</h4>
        </div>

        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4" id="productListArea">
            @foreach (var item in Model.LatestProducts)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 product-card">
                        <img src="@item.ImageUrl" class="card-img-top p-3 rounded-4" alt="@item.Name" style="height: 200px; object-fit: contain;">
                        <div class="card-body d-flex flex-column pt-0">
                            <span class="badge bg-light text-dark mb-2 align-self-start border">@item.Category</span>
                            <h6 class="card-title text-truncate" title="@item.Name">@item.Name</h6>
                            <h5 class="card-text text-primary fw-bold pb-2">@item.Price ₺</h5>

                            <!-- İŞTE EKSİK OLAN KISIM BURASI: Numara Seçimi -->
                            <div class="mb-2 mt-auto">
                                <select class="form-select form-select-sm border-secondary" id="size-@item.Id">
                                    <option value="">Numara Seçin</option>
                                    @if (item.Sizes != null)
                                    {
                                        @foreach (var size in item.Sizes)
                                        {
                                            <option value="@size">@size</option>
                                        }
                                    }
                                </select>
                            </div>

                            <!-- Sepete Ekle Butonu -->
                            <div class="d-grid gap-2">
                                <button class="btn btn-outline-primary btn-sm btn-add-cart" data-id="@item.Id">
                                    🛒 Sepete Ekle
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </main>

</div>

  