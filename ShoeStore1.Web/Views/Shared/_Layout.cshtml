@using Microsoft.AspNetCore.Identity
@using ShoeStore1.Data.Identity
@using System.Text.Json
@inject UserManager<AppUser> userManager

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewData["Title"] - Ayakabı Mağazası</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container">
                <a class="navbar-brand" href="/">ShoeStore</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">

                    <!-- 1. SOL TARAF: Normal Menü Linkleri -->
                    <!-- 'me-auto' sınıfı (margin-end: auto), kendinden sonra gelen her şeyi en sağa iter -->
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link active" href="/">Ana Sayfa</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">Ürünler</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">İletişim</a>
                        </li>
                    </ul>

                    <!-- 2. SAĞ TARAF: Kullanıcı Menüsü ve Sepet -->
                    <ul class="navbar-nav align-items-center">

                        <!-- KULLANICI MENÜSÜ -->
                        @if (User.Identity.IsAuthenticated)
                        {
                            <!-- Kullanıcı giriş yapmışsa gösterilecek Dropdown -->
                            <li class="nav-item dropdown me-3">
                                <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    👤 Merhaba, @User.Identity.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="userDropdown">
                                    <li><a class="dropdown-item" href="/Account/Profile">Kullanıcı Bilgilerim</a></li>
                                    <li><a class="dropdown-item" href="/Account/Addresses">Adreslerim</a></li>
                                    <li><a class="dropdown-item" href="/Account/Orders">Geçmiş Siparişlerim</a></li>

                                    <!-- Eğer giriş yapan kullanıcı Admin ise panele gitme linki görünsün -->
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item fw-bold text-danger" href="/Admin/Dashboard">📦 Ürün Yönetim Paneli</a></li>
                                    }

                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="/Account/Logout">Çıkış Yap</a></li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <!-- Kullanıcı giriş yapmamışsa gösterilecek Butonlar -->
                            <li class="nav-item">
                                <a class="nav-link" href="/Account/Login">Giriş Yap</a>
                            </li>
                            <li class="nav-item me-3">
                                <a class="nav-link" href="/Account/Register">Kayıt Ol</a>
                            </li>
                        }

                        <!-- SEPET MENÜSÜ -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle btn btn-outline-secondary text-white border-0" href="#" id="cartDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                🛒 Sepetim
                                <span class="badge bg-danger rounded-pill" id="cartItemCount">0</span>
                            </a>

                            <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="cartDropdown" style="width: 320px;">
                                <li class="p-3 text-center text-muted">Sepetinizde ürün bulunmamaktadır.</li>
                                <!-- Sepet içeriği buraya eklenecek site.js de yüklendi -->
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <main class="container mt-4 mb-5 flex-grow-1">
        @RenderBody()
    </main>
    <footer class="bg-light text-center py-3 mt-auto">
        <div class="container">
            <p class="mb-0">&copy; @DateTime.Now.Year - ShoeStore Tüm Hakları Saklıdır.</p>
        </div>
    </footer>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
            window.CurrentUser = null;
            @if (User.Identity.IsAuthenticated)
                {
                    var appUser = await userManager.GetUserAsync(User);
                    if (appUser != null) // Kullanıcı bilgisi null değilse
                    {
                        var jsUserData = new // Kullanıcı bilgilerini JSON formatında JavaScript'e aktar
                        {
                            Id = appUser.Id,
                            Email = appUser.Email,
                            FirstName = appUser.FirstName,
                            LastName = appUser.LastName,
                            FullName = $"{appUser.FirstName} {appUser.LastName}"    
                        };
                        <text>
                                window.CurrentUser = @Html.Raw(JsonSerializer.Serialize(jsUserData));
                        </text>// Kullanıcı bilgilerini JavaScript'e aktar
                    
                    }
            }

    </script>

    @await RenderSectionAsync("Scripts", required: false) <!-- Bu satır, sayfa özelinde eklenmiş JavaScript kodlarını yükler-->
    
    <script src="~/js/site.js"></script>

</body>
</html>
