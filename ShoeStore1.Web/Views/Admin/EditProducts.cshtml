@model List<ShoeStore1.Web.Models.ViewModels.AdminProductViewModel>
@{
    ViewData["Title"] = "Mevcut Ürünler";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>📦 Mevcut Ürünler Paneli</h2>

        <a href="/Admin/AddProducts" class="btn btn-primary">
            ➕ Yeni Ürün Ekle
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <table class="table table-hover align-middle">

                <thead>
                    <tr>
                        <th>Ürün ID</th>
                        <th>Ürün Adı</th>
                        <th>Kategori</th>
                        <th>Fiyat</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>

                <tbody>

                    <!-- Ürünler burada listelenecek -->
                    @foreach (var product in Model)
                    {
                        <tr>
                            <td>@product.Id</td>
                            <td>@product.Name</td>
                            <td>@product.CategoryName</td>
                            <td>@product.Price.ToString("N2") ₺</td>
                            <td>
                                <a href="#" class="btn btn-sm btn-warning">
                                    ✏️ Düzenle
                                </a>
                                <a href="/Admin/ProductSizes/@product.Id"
                                   class="btn btn-sm btn-info">
                                    👟 Beden & Stok
                                </a>
                                <a href="#" class="btn btn-sm btn-danger">
                                    🗑️ Sil
                                </a>
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>
    </div>

</div>
```
